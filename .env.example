# Copiar a .env (ignorado por git) y completar con valores propios.
# Cargar en la terminal antes de ejecutar:  set -a; source .env; set +a

# Conexion a MySQL
DB_URL=jdbc:mysql://localhost:3306/seguridad_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=appuser
DB_PASSWORD=cambiar_por_la_contrasena_de_mysql

# (Opcional) Crear el usuario ADMIN al arrancar si no existe
ADMIN_EMAIL=
ADMIN_PASSWORD=
